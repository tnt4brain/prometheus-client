<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="prometheus_fpc"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Sergei Pechenko"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="$(ProjOutDir)"/>
        <OtherUnitFiles Value="src"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CompilerPath Value="$(CompPath)"/>
      </Other>
    </CompilerOptions>
    <Description Value="Prometheus client for Free Pascal with lock-free, thread-safe metrics (counter, gauge, histogram) and text exposition format 0.0.4."/>
    <License Value="BSD-3-Clause"/>
    <Version Minor="1"/>
    <Files Count="5">
      <Item1>
        <Filename Value="src/prom_atomic.pas"/>
        <UnitName Value="prom_atomic"/>
      </Item1>
      <Item2>
        <Filename Value="src/prom_exposition.pas"/>
        <UnitName Value="prom_exposition"/>
      </Item2>
      <Item3>
        <Filename Value="src/prom_metrics.pas"/>
        <UnitName Value="prom_metrics"/>
      </Item3>
      <Item4>
        <Filename Value="src/prom_registry.pas"/>
        <UnitName Value="prom_registry"/>
      </Item4>
      <Item5>
        <Filename Value="src/prom_http.pas"/>
        <UnitName Value="prom_http"/>
      </Item5>
    </Files>
    <RequiredPkgs Count="1">
      <Item1>
        <PackageName Value="FCL"/>
      </Item1>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
